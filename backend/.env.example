# Copy to .env for local development. In Docker Compose, these are supplied as
# environment variables instead — see the root docker-compose.yml / .env.example.

DATABASE_URL="postgresql://okovision:okovision@localhost:5432/okovision?schema=public"

NODE_ENV=development
PORT=4000

# HttpOnly/Secure/SameSite=Strict JWT cookie. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_COOKIE_NAME=okovision_session
JWT_EXPIRES_IN=7d

# Set to "true" behind HTTPS (production). Must be false for local http:// dev.
COOKIE_SECURE=false

# AES key used to encrypt the boiler's own password at rest (reversible — the backend
# needs the plaintext to log in to the boiler). Generate with: openssl rand -hex 32
BOILER_CREDENTIALS_KEY=
