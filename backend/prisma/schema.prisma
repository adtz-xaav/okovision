// Prisma schema for Okovision — see docs/architecture (CLAUDE.md) for the data model rationale.
// The legacy app pivoted sensors into columns (one col_N per sensor); SensorReading below is
// deliberately narrow (sensorId, timestamp, value) so adding a sensor is a data change, not a
// schema migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  VIEWER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Sensor {
  id         String          @id @default(uuid())
  key        String          @unique // stable admin-chosen slug, e.g. "outdoor_temp" — independent of wire format
  label      String
  unit       String?
  correction Float           @default(0)
  csvColumn  Int?            @unique // 0-based column index in the boiler's daily CSV, after the jour/heure columns
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  readings   SensorReading[]
  graphLinks GraphSensor[]
}

// Singleton row (id is always "singleton") holding how to reach the boiler on the LAN.
// Historical CSV pull needs only the host. The live channel additionally needs the
// boiler's own web UI login — a separate credential set from Okovision's own users —
// so username/password are optional and only required once live control is configured.
// The password is encrypted at rest (reversible — see lib/crypto.ts), never hashed,
// because the connector genuinely needs the plaintext to log in to the boiler.
model BoilerConnection {
  id                String   @id @default("singleton")
  host              String
  username          String?
  encryptedPassword String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Admin-configured mapping from a friendly name to a real tag path on the boiler's live
// protocol (e.g. "CAPPL:LOCAL.anlage_betriebsart"), discovered by reading the boiler's own
// config.min.js rather than guessed — see PellematicTouchClient. Values on the wire are
// raw scaled integers; divisor converts to/from the human-readable value shown in the UI.
model LiveTag {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  tag       String   @unique
  writable  Boolean  @default(false)
  divisor   Float    @default(1)
  unit      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SensorReading {
  id        BigInt   @id @default(autoincrement())
  sensorId  String
  sensor    Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  timestamp DateTime
  value     Float

  @@unique([sensorId, timestamp])
  @@index([sensorId, timestamp])
}

model Graph {
  id        String        @id @default(uuid())
  name      String
  position  Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  sensors   GraphSensor[]
}

model GraphSensor {
  id         String @id @default(uuid())
  graphId    String
  graph      Graph  @relation(fields: [graphId], references: [id], onDelete: Cascade)
  sensorId   String
  sensor     Sensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  coefficient Float @default(1)
  position   Int    @default(0)

  @@unique([graphId, sensorId])
}

model Season {
  id        String   @id @default(uuid())
  label     String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
}

model SiloEvent {
  id        String   @id @default(uuid())
  occurredAt DateTime
  note      String?
  createdAt DateTime @default(now())
}

model BoilerConfigSnapshot {
  id        String   @id @default(uuid())
  label     String?
  payload   Json
  createdAt DateTime @default(now())
}

enum SchedulerRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model SchedulerRun {
  id          String             @id @default(uuid())
  job         String // e.g. "boiler-ingest", "daily-synthesis"
  status      SchedulerRunStatus @default(PENDING)
  startedAt   DateTime           @default(now())
  finishedAt  DateTime?
  error       String?
  triggeredBy String? // job name of the upstream run that triggered this one, for DAG triggers

  @@index([job, startedAt])
}
