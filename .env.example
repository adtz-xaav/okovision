# Copy to .env at the repo root before running `docker compose up`.

POSTGRES_USER=okovision
# Required — the database is not reachable from outside the Docker network, but a weak
# well-known default is still a bad idea. Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=okovision

BACKEND_PORT=4000
FRONTEND_PORT=8080

# HttpOnly/Secure/SameSite=Strict JWT cookie. Generate with: openssl rand -base64 48
JWT_SECRET=

# AES key encrypting the boiler's own password at rest. Generate with: openssl rand -hex 32
BOILER_CREDENTIALS_KEY=

# Set to "true" once served over HTTPS (e.g. behind a reverse proxy). Must stay
# "false" for plain-LAN/no-TLS setups — a Secure cookie is silently dropped by
# the browser over HTTP, which breaks login.
COOKIE_SECURE=false

# The origin your browser actually loads the app from. Only needs to be set if
# you're putting a reverse proxy in front (see README) — defaults to
# http://localhost:<FRONTEND_PORT>, which is correct for a plain LAN setup.
# CORS_ORIGIN=https://okovision.example.com
