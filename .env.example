# Copy to .env at the repo root before running `docker compose up`.

POSTGRES_USER=okovision
POSTGRES_PASSWORD=okovision
POSTGRES_DB=okovision
POSTGRES_PORT=5432

BACKEND_PORT=4000
FRONTEND_PORT=8080

# HttpOnly/Secure/SameSite=Strict JWT cookie. Generate with: openssl rand -base64 48
JWT_SECRET=

# AES key encrypting the boiler's own password at rest. Generate with: openssl rand -hex 32
BOILER_CREDENTIALS_KEY=

# Set to "true" once served over HTTPS (e.g. behind a reverse proxy).
COOKIE_SECURE=false
